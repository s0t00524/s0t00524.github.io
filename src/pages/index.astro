---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { allNews, allPublications, awards, education, experience, formatMonth, formatPeriod, profile, service, sitePath } from '../lib/data';
const featured = allPublications.filter((publication) => publication.featured).slice(0, 5);
const latestNews = allNews.slice(0, 8);
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-main">
        <p class="eyebrow">Researcher · Network Service Systems</p>
        <h1>{profile.name.display}<span class="name-jp">{profile.name.japanese}</span></h1>
        <p class="hero-role">{profile.position} <span>@</span> {profile.affiliation}</p>
        <p class="hero-statement">{profile.research_statement}</p>
        <div class="button-row">
          <a class="button primary" href={sitePath('cv/SotoAnno_CV.pdf')}>Download CV</a>
          <a class="button" href={profile.links.scholar}>Google Scholar <span aria-hidden="true">↗</span></a>
          <a class="button" href={profile.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="button" href={profile.links.github}>GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <nav class="section-tabs" aria-label="On this page">
          <a href="#about">About</a>
          <a href="#research">Research Areas</a>
          <a href="#news">Latest News</a>
          <a href="#publications">Publications</a>
          <a href="#awards">Awards</a>
          <a href="#service">Academic Service</a>
          <a href="#experience">Experience</a>
          <a href="#education">Education</a>
        </nav>
      </div>
      <aside class="hero-aside" aria-label="Profile summary">
        <div class="coordinate"><span>FOCUS</span><strong>Mobility × Networks × AI</strong></div>
        <div class="coordinate"><span>BASED IN</span><strong>{profile.location}</strong></div>
        <div class="coordinate"><span>CONTACT</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div>
        <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </aside>
    </div>
  </section>

  <section class="section shell two-column" id="about">
    <div class="section-label"><span>01</span><h2>About</h2></div>
    <div class="prose lead"><p>{profile.biography}</p><p>{profile.research_interests[0].description} My broader interests include machine learning, big data analysis, geographic information systems, context-aware computing, and computer vision.</p></div>
  </section>

  <section class="section shell" id="research">
    <div class="section-heading"><div class="section-label"><span>02</span><h2>Research Areas</h2></div><p>Connecting real-world measurement, predictive learning, and dependable communication systems.</p></div>
    <div class="research-grid">
      {profile.research_interests.map((interest: any, index: number) => (
        <article class="research-card"><span>0{index + 1}</span><h3>{interest.title}</h3><p>{interest.description}</p></article>
      ))}
    </div>
  </section>

  <section class="section section-tint" id="news">
    <div class="shell two-column">
      <div class="section-label"><span>03</span><h2>Latest News</h2></div>
      <ol class="news-list">
        {latestNews.map((item) => <li><time datetime={item.date}>{formatMonth(item.date)}</time><div><span class={`news-type ${item.type}`}>{item.type}</span>{item.url ? <a href={item.url}>{item.text}</a> : <p>{item.text}</p>}</div></li>)}
      </ol>
    </div>
  </section>

  <section class="section shell" id="publications">
    <div class="section-heading"><div class="section-label"><span>04</span><h2>Selected Publications</h2></div><a class="text-link" href={sitePath('publications/')}>View all {allPublications.length} publications →</a></div>
    <div class="publication-list featured-list">{featured.map((publication) => <PublicationItem publication={publication} />)}</div>
  </section>

  <section class="section shell split-panels">
    <div id="awards">
      <div class="section-label small"><span>05</span><h2>Awards</h2></div>
      <ul class="fact-list">{awards.map((award) => <li><time>{formatMonth(award.date)}</time><a href={award.url}>{award.title}</a></li>)}</ul>
    </div>
    <div id="service">
      <div class="section-label small"><span>06</span><h2>Academic Service</h2></div>
      <ul class="service-list">
        <li><strong>Steering</strong><ul class="service-items">{service.steering.map((item: any) => <li>{item.organization} ({item.period})</li>)}</ul></li>
        <li><strong>Program committees</strong><ul class="service-items">{service.tpc.map((item: any) => <li>{item.organization} {item.year}</li>)}</ul></li>
        <li><strong>Reviewing</strong><ul class="service-items">{[...service.reviewing.journals, ...service.reviewing.conferences].map((item: string) => <li>{item}</li>)}</ul></li>
      </ul>
    </div>
  </section>

  <section class="section shell timeline-section">
    <div id="experience"><div class="section-label small"><span>07</span><h2>Experience</h2></div>{experience.map((item) => <article class="timeline-item"><time>{formatPeriod(item.start, item.end)}</time><div><h3>{item.role}</h3><a href={item.url}>{item.organization}</a></div></article>)}</div>
    <div id="education"><div class="section-label small"><span>08</span><h2>Education</h2></div>{education.map((item) => <article class="timeline-item"><time>{formatPeriod(item.start, item.end)}</time><div><h3>{item.degree}</h3><p>{item.institution}</p>{item.note && <small>{item.note}</small>}</div></article>)}</div>
  </section>

  <section class="section shell memberships">
    <h2>Professional Memberships</h2>
    <div>{profile.memberships.map((membership: any) => <a href={membership.url}>{membership.name}</a>)}</div>
  </section>
</BaseLayout>
