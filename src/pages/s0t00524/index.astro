---
const destination = "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href="https://s0t00524.github.io/" />
    <title>Redirecting...</title>
    <script is:inline>
      window.location.replace("/");
    </script>
  </head>

  <body>
    <p>
      This page has moved to
      <a href="/">https://s0t00524.github.io/</a>.
    </p>
  </body>
</html>