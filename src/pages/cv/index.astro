---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile, sitePath } from '../../lib/data';
---
<BaseLayout title="Curriculum Vitae" description={`Curriculum vitae of ${profile.name.english}.`}>
  <section class="cv-page shell">
    <div class="cv-copy"><p class="eyebrow">Curriculum vitae</p><h1>A concise record of research, publications, and service.</h1><p>The PDF is typeset with LaTeX and rebuilt from the same YAML and BibTeX sources as this website. Its fixed URL always points to the latest deployed version.</p><a class="button primary" href={sitePath('cv/SotoAnno_CV.pdf')}>Download SotoAnno_CV.pdf</a></div>
    <aside class="document-card"><div class="document-top"><span>PDF</span><i></i></div><div class="document-lines"><b></b><b></b><b></b><b></b><b></b></div><p>{profile.name.display}</p><small>Generated by CI</small></aside>
  </section>
</BaseLayout>
